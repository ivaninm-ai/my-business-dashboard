{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/business-dashboard/setup-package/1.0",
  "title": "Business dashboard setup package",
  "description": "Versioned configuration/import contract shared by the onboarding skill and the dashboard application. Data only: no expressions, formulas or code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_version",
    "package_id",
    "generated_at",
    "confirmation",
    "business",
    "reporting_date",
    "modules",
    "sources",
    "tables",
    "policies"
  ],
  "properties": {
    "package_version": {
      "const": "1.0"
    },
    "package_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{4,64}$"
    },
    "generated_at": {
      "type": "string"
    },
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "draft",
            "confirmed"
          ]
        },
        "confirmed_by": {
          "type": "string"
        },
        "confirmed_at": {
          "type": "string"
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "business": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "timezone",
        "currency"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "model": {
          "enum": [
            "b2c",
            "b2b",
            "service",
            "mixed",
            "other"
          ]
        },
        "industry": {
          "type": "string",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "team": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "locale": {
          "type": "string",
          "maxLength": 20
        },
        "timezone": {
          "type": "string",
          "maxLength": 60
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "currency_symbol": {
          "type": "string",
          "maxLength": 8
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "ai_guidance": {
          "type": "string",
          "maxLength": 4000
        },
        "synthetic": {
          "type": "boolean"
        }
      }
    },
    "reporting_date": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "fixed",
            "today",
            "latest_event_date"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "note": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "enum": [
            "month_to_date",
            "last_30_days",
            "last_7_days",
            "all_history"
          ]
        },
        "history_start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overview": {
          "type": "boolean"
        },
        "sales": {
          "type": "boolean"
        },
        "customers": {
          "type": "boolean"
        },
        "payments": {
          "type": "boolean"
        },
        "stock": {
          "type": "boolean"
        },
        "tasks": {
          "type": "boolean"
        },
        "calendar": {
          "type": "boolean"
        },
        "ai": {
          "type": "boolean"
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "customers": {
          "type": "string",
          "maxLength": 40
        },
        "customer": {
          "type": "string",
          "maxLength": 40
        },
        "sales": {
          "type": "string",
          "maxLength": 40
        },
        "sale": {
          "type": "string",
          "maxLength": 40
        },
        "payments": {
          "type": "string",
          "maxLength": 40
        },
        "payment": {
          "type": "string",
          "maxLength": 40
        },
        "stock": {
          "type": "string",
          "maxLength": 40
        },
        "item": {
          "type": "string",
          "maxLength": 40
        },
        "owner": {
          "type": "string",
          "maxLength": 40
        },
        "channel": {
          "type": "string",
          "maxLength": 40
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "kind"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,40}$"
          },
          "kind": {
            "enum": [
              "google_sheet",
              "manual_package"
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 120
          },
          "spreadsheet_id": {
            "type": "string",
            "pattern": "^([A-Za-z0-9_-]{10,})?$"
          },
          "refresh": {
            "enum": [
              "scheduled",
              "manual"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "table_id",
          "entity",
          "source_id",
          "fields"
        ],
        "properties": {
          "table_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,40}$"
          },
          "entity": {
            "enum": [
              "customers",
              "sales",
              "payments",
              "stock"
            ]
          },
          "source_id": {
            "type": "string"
          },
          "sheet_name": {
            "type": "string",
            "maxLength": 100
          },
          "header_row": {
            "type": "integer"
          },
          "row_meaning": {
            "type": "string",
            "maxLength": 300
          },
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "source_id",
                  "composite",
                  "row_number"
                ]
              },
              "field": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "limits": {
                "type": "string",
                "maxLength": 500
              }
            }
          },
          "load": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "enum": [
                  "replace"
                ]
              }
            }
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "canonical"
              ],
              "properties": {
                "canonical": {
                  "type": "string"
                },
                "header": {
                  "type": "string",
                  "maxLength": 200
                },
                "constant": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "date_order": {
                  "enum": [
                    "dmy",
                    "mdy",
                    "ymd"
                  ]
                },
                "values": {
                  "type": "object"
                },
                "note": {
                  "type": "string",
                  "maxLength": 300
                },
                "confidence": {
                  "enum": [
                    "documented",
                    "interpreted",
                    "confirmed"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "status_map": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pending": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "done": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blank": {
          "enum": [
            "pending",
            "done",
            "excluded"
          ]
        }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "order": {
              "enum": [
                "dmy",
                "mdy",
                "ymd"
              ]
            }
          }
        },
        "money": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "unit": {
              "enum": [
                "major"
              ]
            }
          }
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule"
            ],
            "properties": {
              "rule": {
                "enum": [
                  "payment_follow_up",
                  "follow_up_due",
                  "review_account",
                  "review_replenishment",
                  "completion_overdue",
                  "completion_due_soon",
                  "unassigned_prospect"
                ]
              },
              "enabled": {
                "type": "boolean"
              },
              "params": {
                "type": "object"
              },
              "note": {
                "type": "string",
                "maxLength": 300
              }
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sample": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "row_counts": {
              "type": "object"
            },
            "totals": {
              "type": "object"
            },
            "reporting_date": {
              "type": "string"
            },
            "note": {
              "type": "string",
              "maxLength": 300
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "samples": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "meanings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "meaning"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "meaning": {
            "type": "string",
            "maxLength": 1000
          },
          "basis": {
            "enum": [
              "documented",
              "interpreted",
              "confirmed"
            ]
          }
        }
      }
    },
    "records": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "customers": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "sales": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "payments": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "stock": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
